# What `bun new.mjs --develop <template>` and its builds add to a template's app/, for this
# machine only
*/app/.cargo/
*/app/.exact/
*/app/.gitignore
*/app/.vscode/
*/app/AGENTS.md
*/app/CLAUDE.md
*/app/Cargo.lock
*/app/Cargo.toml
*/app/app.contract.d.ts
*/app/apple/
*/app/dist*
*/app/exact.mjs
*/app/linux/
*/app/node_modules/
*/app/package.json
*/app/rust-toolchain.toml
*/app/target/
*/app/web/
.DS_Store

# Apple's photos and icon, which landscapes/app/scripts/fetch-images.sh fetches: the sample's
# license does not cover the photos
landscapes/app/assets/apple/

# Softwear's per-machine API address. Its backend keeps its own local state and secrets out of git
# (softwear/backend/.gitignore: .wrangler/, .dev.vars, node_modules/)
softwear/app/.env.local
