# Cloudflare D1 Configuration (for drizzle-kit migrations)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# Auth Database (Better Auth tables)
CLOUDFLARE_AUTH_DATABASE_ID=your-auth-database-id

# Features Database (application tables)
CLOUDFLARE_FEATURES_DATABASE_ID=your-features-database-id

# Security Audit Database (unsafe cross-tenant action logs)
CLOUDFLARE_AUDIT_DATABASE_ID=your-audit-database-id

