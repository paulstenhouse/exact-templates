// Run by `test` or `verify`, which start server.ts (the Quickback backend, seeded) on an empty database for the whole run. Each test starts from
// empty storage, as a first visit does; `reload` keeps it, as a return visit does. A test that walks the site's
// own header runs on the web; the installed app's chrome has its own test at the end.

test "the shop filters by the category in its location, and the selects write the query" on web
  size 1280x900
  at "/shop"
  clock data
  expect state shopShown.length == 46
  tap "chip-hoodies"
  clock settle
  expect state cat == "hoodies"
  expect state shopShown.length == 7
  expect text "shop-title" == "Hoodies"
  type "gender" "women"
  clock settle
  expect state gender == "women"
  expect state shopShown.length == 7
  type "sort" "price-asc"
  clock settle
  expect state shopShown.0 .name == "Eco-Jersey Zip Hoodie"
  tap "chip-sale"
  clock settle
  expect state cat == "sale"
  expect state shopShown.length == 5

test "a filtered shop is a page: its link opens filtered, and Back leaves the shop in one step" on web
  size 1280x900
  at "/shop?c=pants&s=price-desc"
  clock data
  expect text "shop-count" == "4 styles"
  expect state shopShown.0 .name == "Eco-Cozy Fleece Sweatpants"
  tap "chip-kids"
  clock settle
  expect state cat == "kids"
  back
  clock settle
  expect state nav.tab == "shop"
  expect state stackDepth == 1

test "a product is added in its colour and size, merged on a repeat, and kept across a relaunch" on web
  size 1280x900
  at "/p/challenger-eco-fleece-hoodie"
  clock data
  clock settle
  expect text "product-name" == "Challenger Eco-Fleece Hoodie"
  expect text "shown-color" == "Shown in Eco True Black"
  tap "add-to-bag"
  expect tree has "size-hint"
  expect state bag == []
  tap "color-2"
  expect text "shown-color" == "Shown in Eco True Navy"
  tap "size-L"
  expect text "size-label" == "Size: L"
  expect tree missing "size-hint"
  tap "add-to-bag"
  expect state bag.0 == "challenger-eco-fleece-hoodie|Eco True Navy|L|1"
  expect tree has "toast"
  type "qty" "2"
  tap "add-to-bag"
  expect state bag.0 == "challenger-eco-fleece-hoodie|Eco True Navy|L|3"
  expect state bag.length == 1
  expect state qty == "1"
  tap "qty-more"
  expect state qty == "2"
  expect text "bag-count" == "3"
  reload
  clock data
  expect text "bag-count" == "3"

test "the product page says what is sold out and what is nearly gone, from the server's stock" on web, ios
  at "/p/challenger-eco-fleece-hoodie"
  clock data
  clock settle
  expect state stock.ready == true
  expect disabled "size-3XL"
  expect text "stock-note" == "Sold out in 3XL"

test "the bag changes a quantity, removes a line, applies a promo code and prices shipping" on web
  size 1280x900
  at "/account"
  clock data
  type "signin-email" "promo@example.com"
  type "signin-password" "softwear-demo"
  tap "signin"
  clock data
  tap "nav-shop"
  clock settle
  tap "card-go-to-tee"
  clock data
  clock settle
  tap "size-XS"
  tap "add-to-bag"
  tap "nav-bag"
  clock settle
  expect text "bag-title" == "Your bag · 1 item"
  expect text "subtotal" == "$30.00"
  expect text "shipping" == "$6.00"
  expect text "free-shipping-hint" == "Add $45.00 more for free shipping."
  tap "qty-more-0"
  tap "qty-more-0"
  expect text "subtotal" == "$90.00"
  expect text "shipping" == "Free"
  expect text "total" == "$90.00"
  type "promo" "welcome15"
  tap "apply-promo"
  clock data
  expect state promo == "WELCOME15"
  expect text "discount" == "−$13.50"
  expect text "total" == "$76.50"
  type "promo" "NOPE"
  tap "apply-promo"
  clock data
  expect text "promo-note" == "NOPE isn't a code we know."
  expect text "total" == "$90.00"
  tap "remove-0"
  expect state bag == []
  expect tree has "bag-shop"

test "checkout waits for the address, then places the order, which clears the bag and has its own page" on web
  size 1280x900
  at "/p/eco-fleece-dodgeball-joggers"
  clock data
  clock settle
  tap "size-S"
  tap "add-to-bag"
  tap "nav-bag"
  clock settle
  tap "checkout"
  clock settle
  expect disabled "place-order"
  expect text "co-hint" == "Sign in to place your order."
  tap "nav-account"
  clock settle
  type "signin-email" "ada@example.com"
  type "signin-password" "softwear-demo"
  tap "signin"
  clock data
  expect text "member" == "ada@example.com"
  tap "nav-bag"
  clock settle
  clock data
  tap "checkout"
  clock settle
  expect text "co-hint" == "Enter the name it ships to."
  type "co-name" "Ada Lovelace"
  expect text "co-hint" == "Enter the shipping address."
  type "co-address" "12 Analytical Way"
  type "co-city" "London"
  type "co-zip" "94110"
  expect enabled "place-order"
  tap "ship-express"
  expect text "co-total" == "$78.00"
  tap "ship-standard"
  expect text "co-total" == "$70.00"
  tap "place-order"
  clock data
  clock settle
  expect state bag == []
  expect text "order-title" == "Your order is in, Ada Lovelace."
  expect text "order-total" == "$70.00"
  tap "order-account"
  clock settle
  clock data
  expect text "member" == "ada@example.com"
  expect tree missing "no-orders"

test "an order the server refuses keeps the bag and says why" on web
  size 1280x900
  at "/account"
  clock data
  type "signin-email" "grace@example.com"
  type "signin-password" "softwear-demo"
  tap "signin"
  clock data
  tap "nav-shop"
  clock settle
  tap "card-go-to-tee"
  clock data
  clock settle
  tap "size-XS"
  tap "add-to-bag"
  tap "nav-bag"
  clock settle
  tap "checkout"
  clock settle
  type "co-name" "Grace Hopper"
  type "co-address" "1 Compiler Court"
  type "co-city" "Arlington"
  type "co-zip" "22201"
  fail fetch "/api/v1/checkout"
  tap "place-order"
  clock data
  expect state bag.length == 1
  expect tree has "co-error"
  tap "co-edit-bag"
  clock settle
  expect tree has "bag-lines"
  pass fetch "/api/v1/checkout"

test "joining the list earns the welcome code once, and the account page remembers it" on web
  size 1280x900
  clock data
  type "home-join-email" "not an address"
  tap "home-join"
  clock data
  expect text "home-join-note" == "Enter an email address, like you@example.com."
  type "home-join-email" "fan@example.com"
  tap "home-join"
  clock data
  expect text "home-join-note" == "You're in. WELCOME15 takes 15% off your first order."
  tap "home-join-apply"
  expect state promo == "WELCOME15"
  expect tree has "home-join-applied"
  tap "nav-account"
  clock settle
  type "signin-email" "fan@example.com"
  type "signin-password" "softwear-demo"
  tap "signin"
  clock data
  expect text "member" == "fan@example.com"
  expect text "account-list" == "You're on it"
  reload
  clock data
  expect text "member" == "fan@example.com"
  tap "signout"
  expect tree has "signin"

test "search finds by name, fabric, category, colour and style number, and an empty search offers popular ones" on web
  size 1280x900
  at "/search?q=slub"
  clock data
  expect text "result-count" == "3 matches"
  type "search" "navy"
  clock settle
  expect text "result-count" == "39 matches"
  type "search" "9595"
  clock settle
  expect text "result-count" == "2 matches"
  type "search" "eco-fleece joggers"
  clock settle
  expect text "result-count" == "2 matches"
  type "search" "zzzz"
  clock settle
  expect tree has "search-shop"
  type "search" ""
  clock settle
  expect tree has "popular-Kids"
  tap "popular-Kids"
  clock settle
  expect text "result-count" == "5 matches"

