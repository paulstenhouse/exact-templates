test "the kids filter shows only kids' styles, and the size filter narrows to styles in that size" on web
  size 1280x900
  at "/shop?g=kids"
  clock data
  expect state shopShown.length == 5
  tap "chip-hoodies"
  clock settle
  expect state shopShown.length == 0
  tap "chip-all"
  clock settle
  type "gender" ""
  clock settle
  expect state shopShown.length == 46
  type "size" "One Size"
  clock settle
  expect text "shop-count" == "2 styles"
  type "size" "YXL"
  clock settle
  expect state sizeFilter == "YXL"
  expect state shopShown.length == 5
  tap "chip-kids"
  clock settle
  expect state sizeFilter == "YXL"
  expect state cat == "kids"

