// The whole store against the backend: a new account, a hoodie in the bag, the welcome code priced by the server,
// an order, and the order read back from the account.
test "a new shopper signs up, bags a hoodie, takes 15% off with WELCOME15, checks out and sees the order" on web
  size 1280x900
  at "/account"
  clock data
  type "signin-email" "member@example.com"
  type "signin-password" "softwear-demo"
  tap "signin"
  clock data
  expect text "member" == "member@example.com"
  expect text "account-code" == "WELCOME15"
  expect tree has "no-orders"
  tap "nav-hoodies"
  clock settle
  tap "card-challenger-eco-fleece-hoodie"
  clock data
  clock settle
  tap "size-M"
  tap "add-to-bag"
  tap "nav-bag"
  clock settle
  clock data
  expect text "subtotal" == "$74.00"
  type "promo" "welcome15"
  tap "apply-promo"
  clock data
  expect text "promo-note" == "WELCOME15 applied: 15% off."
  expect text "discount" == "−$11.10"
  tap "checkout"
  clock settle
  type "co-name" "Member One"
  type "co-address" "1 Test St"
  type "co-city" "Test"
  type "co-zip" "00000"
  expect text "co-total" == "$68.90"
  tap "place-order"
  clock data
  clock settle
  expect state bag == []
  expect text "order-title" == "Your order is in, Member One."
  expect text "order-total" == "$68.90"
  tap "order-account"
  clock settle
  clock data
  expect state orders.length == 1
  expect state orders.0 .totalCents == 6890
  expect state orders.0 .status == "placed"
  expect text "account-code" == "Used"

test "the welcome code is spent: the server refuses it on a second order" on web
  size 1280x900
  at "/account"
  clock data
  type "signin-email" "member@example.com"
  type "signin-password" "softwear-demo"
  tap "signin"
  clock data
  tap "nav-hoodies"
  clock settle
  tap "card-challenger-eco-fleece-hoodie"
  clock data
  clock settle
  tap "size-S"
  tap "add-to-bag"
  tap "nav-bag"
  clock settle
  clock data
  type "promo" "WELCOME15"
  tap "apply-promo"
  clock data
  expect text "promo-note" == "WELCOME15 is for a first order, and you have used it."
  expect text "total" == "$80.00"

test "what one shopper keeps is not another's: the orders, bag and saved styles are the account's" on web
  size 1280x900
  at "/account"
  clock data
  type "signin-email" "member@example.com"
  type "signin-password" "softwear-demo"
  tap "signin"
  clock data
  expect state orders.length == 1
  tap "signout"
  type "signin-email" "stranger@example.com"
  type "signin-password" "softwear-demo"
  tap "signin"
  clock data
  expect text "member" == "stranger@example.com"
  expect tree has "no-orders"
  tap "signout"
  type "signin-email" "member@example.com"
  type "signin-password" "not-the-password"
  tap "signin"
  clock data
  expect text "signin-error" == "That password doesn’t match this email."

test "a size carried from another product is dropped where it is sold out, so nothing sold out is added" on web
  size 1280x900
  at "/p/champ-eco-fleece-crewneck-sweatshirt"
  clock data
  clock settle
  tap "size-3XL"
  expect text "size-label" == "Size: 3XL"
  tap "nav-hoodies"
  clock settle
  tap "card-challenger-eco-fleece-hoodie"
  clock data
  clock settle
  expect state stock.ready == true
  expect text "size-label" == "Size"
  expect text "add-to-bag" == "Choose a size"
  expect text "stock-note" == "Sold out in 3XL"
  expect tree has "low-2XL"
  tap "add-to-bag"
  expect state bag == []
  expect tree has "size-hint"

