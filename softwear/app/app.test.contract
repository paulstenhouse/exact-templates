test "the app gets the tab bar and the platform's bars, and each tab keeps its own stack" on ios, android
  clock data
  expect tree missing "nav-bag"
  tap "tab-search"
  clock settle
  type "search-app" "beanie"
  clock settle
  expect text "result-count" == "1 match"
  tap "card-eco-knit-cuff-beanie"
  clock data
  clock settle
  // UIKit's push ends on the wall's time, which the agent's clock does not move: on a phone the route may not be in
  // its window yet.
  clock +800 real
  clock settle
  tap "size-One Size"
  tap "add-to-bag"
  tap "tab-bag"
  clock settle
  expect text "subtotal" == "$22.00"
  tap "tab-search"
  clock settle
  expect tree has "add-to-bag"

test "the app's toast says what was added on the route it is on, closes, and leads to the bag" on ios, android
  clock data
  tap "tab-shop"
  clock settle
  tap "card-go-to-tee"
  clock data
  clock settle
  clock +800 real
  clock settle
  tap "size-XS"
  tap "add-to-bag"
  expect tree has "toast"
  tap "toast-close"
  expect tree missing "toast"
  tap "add-to-bag"
  tap "toast-bag"
  clock settle
  expect text "subtotal" == "$60.00"

