test "in the app, a new shopper signs up, bags a hoodie, takes 15% off with WELCOME15, checks out and sees the order" on ios, android
  clock data
  tap "tab-account"
  clock settle
  type "signin-email" "app-member@example.com"
  type "signin-password" "softwear-demo"
  tap "signin"
  clock data
  expect text "member" == "app-member@example.com"
  expect text "account-code" == "WELCOME15"
  tap "tab-search"
  clock settle
  type "search-app" "challenger eco-fleece"
  clock settle
  tap "card-challenger-eco-fleece-hoodie"
  clock data
  clock settle
  clock +800 real
  clock settle
  tap "size-M"
  tap "add-to-bag"
  tap "tab-bag"
  clock settle
  clock data
  expect text "subtotal" == "$74.00"
  type "promo" "welcome15"
  tap "apply-promo"
  clock data
  expect text "discount" == "−$11.10"
  tap "checkout"
  clock settle
  clock +800 real
  clock settle
  type "co-name" "App Member"
  type "co-address" "1 Test St"
  type "co-city" "Test"
  type "co-zip" "00000"
  expect text "co-total" == "$68.90"
  tap "place-order"
  clock data
  clock settle
  clock +800 real
  clock settle
  expect state bag == []
  expect text "order-total" == "$68.90"
  tap "tab-account"
  clock settle
  clock data
  expect state orders.length == 1
  expect state orders.0 .status == "placed"
