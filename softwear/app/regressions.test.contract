test "repeated additions stop at ten and persist the bounded quantity" on web
  at "/p/challenger-eco-fleece-hoodie"
  clock data
  tap "size-S"
  type "qty" "10"
  tap "add-to-bag"
  tap "add-to-bag"
  expect state bagCount == 10
  reload
  clock data
  expect state bagCount == 10

test "joining while signed in refreshes membership without reloading" on web
  at "/account"
  clock data
  type "signin-email" "regression-subscriber@example.com"
  type "signin-password" "softwear-demo"
  tap "signin"
  clock data
  type "account-join-email" "regression-subscriber@example.com"
  tap "account-join"
  clock data
  expect state joinOk == true
  expect text "account-list" == "You're on it"

test "an existing member sees a newly placed order immediately" on web
  at "/account"
  clock data
  type "signin-email" "regression-order@example.com"
  type "signin-password" "softwear-demo"
  tap "signin"
  clock data
  tap "nav-shop"
  clock settle
  tap "card-go-to-tee"
  clock data
  clock settle
  tap "size-XS"
  tap "add-to-bag"
  tap "nav-bag"
  clock settle
  clock data
  tap "checkout"
  clock settle
  type "co-name" "Review"
  type "co-address" "1 Test St"
  type "co-city" "Test"
  type "co-zip" "00000"
  tap "place-order"
  clock data
  clock settle
  expect state bag == []
  tap "order-account"
  clock settle
  clock data
  expect state orders.length == 1

test "a saved name can be cleared, saved empty and loaded again" on web
  at "/account"
  clock data
  type "signin-email" "regression-name@example.com"
  type "signin-password" "softwear-demo"
  tap "signin"
  clock data
  type "name" "Original"
  tap "save-name"
  clock data
  reload
  clock data
  expect text "name" == "Original"
  type "name" ""
  expect text "name" == ""
  tap "save-name"
  clock data
  reload
  clock data
  expect text "name" == ""

test "a failed stock request does not use the previous product's sizes" on web
  at "/p/challenger-eco-fleece-hoodie"
  clock data
  expect disabled "size-3XL"
  fail fetch "/api/v1/stock?limit=100&productSlug=rocky-eco-fleece-zip-hoodie"
  tap "card-rocky-eco-fleece-zip-hoodie"
  clock data
  clock settle
  expect enabled "size-3XL"
  expect text "stock-note" == "Stock isn't available right now; we'll check when you order."

test "an unavailable order can be retried and a real 404 is distinct" on web
  at "/account"
  clock data
  type "signin-email" "regression-missing@example.com"
  type "signin-password" "softwear-demo"
  tap "signin"
  clock data
  fail fetch "/api/v1/orders?limit=100&number=SW-no-such-order"
  type "app" "/order/SW-no-such-order"
  clock data
  expect tree has "order-retry"
  expect tree missing "order-missing-account"
  pass fetch "/api/v1/orders?limit=100&number=SW-no-such-order"
  tap "order-retry"
  clock data
  expect tree missing "order-retry"
  expect tree has "order-missing-account"

test "the bag checks the combined demand of colours sharing a size" on web
  at "/p/challenger-eco-fleece-hoodie"
  clock data
  tap "size-2XL"
  type "qty" "2"
  tap "add-to-bag"
  tap "color-1"
  type "qty" "2"
  tap "add-to-bag"
  tap "nav-bag"
  clock settle
  clock data
  expect state bagCount == 4
  expect state bagShort == 2
  expect disabled "checkout"
  tap "qty-less-1"
  expect state bagShort == 0
  expect enabled "checkout"

test "stock updates immediately after purchasing the last units" on web
  at "/p/challenger-eco-fleece-hoodie"
  clock data
  tap "size-2XL"
  type "qty" "3"
  tap "add-to-bag"
  tap "nav-account"
  clock settle
  type "signin-email" "last-stock@example.com"
  type "signin-password" "softwear-demo"
  tap "signin"
  clock data
  tap "nav-bag"
  clock settle
  clock data
  tap "checkout"
  clock settle
  type "co-name" "Review"
  type "co-address" "1 Test St"
  type "co-city" "Test"
  type "co-zip" "00000"
  tap "place-order"
  clock data
  clock settle
  tap "order-shop"
  clock settle
  tap "card-challenger-eco-fleece-hoodie"
  clock data
  clock settle
  expect disabled "size-2XL"
